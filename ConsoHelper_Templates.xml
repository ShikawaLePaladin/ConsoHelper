<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">

  <EditBox name="ConsoHelperEditBoxTemplate" virtual="true" letters="10">
    <Size>
      <AbsDimension x="40" y="20"/>
    </Size>
    <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background" edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
      <EdgeSize>
        <AbsValue val="8"/>
      </EdgeSize>
      <TileSize>
        <AbsValue val="8"/>
      </TileSize>
      <BackgroundInsets>
        <AbsInset left="2" right="2" top="2" bottom="2"/>
      </BackgroundInsets>
    </Backdrop>
    <FontString inherits="GameFontNormalSmall"/>
    <TextInsets>
      <AbsInset left="4" right="4" top="2" bottom="2"/>
    </TextInsets>
    <Scripts>
      <OnLoad>
        this:SetAutoFocus(false);
        this:SetBackdropColor(0, 0, 0, 0.8);
        this:SetBackdropBorderColor(0.5, 0.5, 0.5, 1);
        this:SetJustifyH("CENTER");
      </OnLoad>
      <OnEnter>
        this:SetBackdropBorderColor(1, 1, 1, 1);
      </OnEnter>
      <OnLeave>
        this:SetBackdropBorderColor(0.5, 0.5, 0.5, 1);
      </OnLeave>
      <OnEditFocusGained>
        this:SetBackdropBorderColor(0, 0.6, 1, 1);
      </OnEditFocusGained>
      <OnEditFocusLost>
        this:SetBackdropBorderColor(0.5, 0.5, 0.5, 1);
      </OnEditFocusLost>
    </Scripts>
  </EditBox>

</Ui>
